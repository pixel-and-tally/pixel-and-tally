// Cloudflare Workers config (free plan). Cloudflare builds with `npm run build`
// and deploys with `npx wrangler deploy`. Static pages are served as assets;
// only the contact form endpoint runs the Worker.
// Custom domains (pixelandtally.com, www) are added in the dashboard under Settings > Domains & Routes.
// Secrets (RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL) are set in the
// Cloudflare dashboard: Workers & Pages > pixel-and-tally > Settings > Variables and Secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-and-tally",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  // nodejs_compat (with a date after 2025-04-01) also fills process.env from the dashboard's variables.
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist", "not_found_handling": "404-page" },
  // Keep variables set in the dashboard when a deploy runs.
  "keep_vars": true,
  "observability": { "enabled": true }
}
