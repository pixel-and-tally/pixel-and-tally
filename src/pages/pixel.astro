---
import Base from "../layouts/Base.astro";
import Tabs from "../components/Tabs.astro";
import PriceList from "../components/PriceList.astro";
import CtaLink from "../components/CtaLink.astro";
import { pixel, pixelPlans, work } from "../site";
---

<Base title="Pixel: websites" description="Websites with online booking for Charlotte restaurants and small businesses, with fixed prices and monthly care.">
  <div class="mx-auto max-w-5xl px-4 pt-10 sm:px-6"><Tabs /></div>

  <section class="mx-auto max-w-5xl px-4 pt-12 sm:px-6">
    <h1 class="max-w-3xl text-4xl leading-tight md:text-5xl">A website that takes bookings while you're busy working.</h1>
    <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed">
      <p>
        If people have to call to book, order or ask your hours, you're losing some of them. I build simple, fast sites
        that work on a phone, take bookings or orders, and show up properly on Google.
      </p>
      <p>
        Every site comes with its first month of care free, so it doesn't go stale the day after launch.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-14 max-w-5xl px-4 sm:px-6">
    <h2 class="mb-2 text-2xl">Builds</h2>
    <PriceList offers={pixel} />
    <h2 class="mb-2 mt-12 text-2xl">Keeping it running</h2>
    <PriceList offers={pixelPlans} />
  </section>

  <section class="mx-auto mt-14 max-w-5xl px-4 sm:px-6">
    <h2 class="text-2xl">Sites I've built</h2>
    <ul class="mt-4 grid gap-6 md:grid-cols-2">
      {
        work.map((w) => (
          <li class="rounded-card bg-sunk p-6">
            <p class="font-display text-xl font-semibold">{w.name}</p>
            <p class="text-sm text-muted">{w.kind}</p>
            <p class="mt-2">{w.summary}</p>
            {w.url && <a href={w.url} class="mt-3 inline-block font-semibold underline">Visit the site</a>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-14 max-w-5xl px-4 sm:px-6">
    <CtaLink href="/contact/?for=pixel" variant="secondary">Book a call about a website</CtaLink>
  </section>
</Base>
