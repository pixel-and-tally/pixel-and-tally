---
import Base from "../layouts/Base.astro";
import Tabs from "../components/Tabs.astro";
import Receipt from "../components/Receipt.astro";
import AskOwner from "../components/AskOwner.astro";
import Faq from "../components/Faq.astro";
import { pixel, pixelPieces, pixelPlans, work } from "../site";
---

<Base title="Charlotte websites with online booking" description="Websites that take bookings and orders for Charlotte restaurants and small businesses. Fixed prices from $900, launched in about 2 weeks, with $95 monthly care.">
  <div class="mx-auto max-w-6xl px-4 pt-10 sm:px-6"><Tabs /></div>

  <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <h1 class="max-w-5xl text-[clamp(2.75rem,7vw,6rem)]">
      Your site should take bookings <span class="text-accent">while you work.</span>
    </h1>
    <div class="mt-8 grid gap-6 text-lg leading-relaxed md:grid-cols-2">
      <p>
        If people have to call to book, order or ask your hours, you're losing some of them. We build simple, fast sites
        that work on a phone, take bookings or orders, and show up properly on Google.
      </p>
      <p>
        Pick a package, or build it piece by piece: one page, then add pages, booking or payments as you need them.
        Every site comes with its first month of care free (2 or 3 months with a package), so it doesn't go stale the day after launch. Logo looking dated?
        I can help with that too, so your site, Google listing and sign all match.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-16 grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-2 md:items-start">
    <Receipt title="Pixel / Packages" ticket="No. 01" offers={pixel} tone="pixel" footer="Cheaper than the same pieces" />
    <Receipt title="Pixel / By the piece" ticket="No. 02" offers={pixelPieces} tone="pixel" />
    <Receipt title="Pixel / Care" ticket="No. 03" offers={pixelPlans} tone="pixel" footer="Cancel any time, 30 days' notice" />
  </section>

  <section id="work" class="mx-auto mt-20 max-w-6xl scroll-mt-6 px-4 sm:px-6">
    <h2 class="text-[clamp(2rem,5vw,3.5rem)]">Sites we've built</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {
        work.map((w, i) => (
          <li class:list={["sticker bg-card p-6", w.features ? "md:col-span-2" : i % 2 ? "md:rotate-1" : "md:-rotate-1"]}>
            {w.image && (
              <img
                src={w.image}
                alt={`The ${w.name} home page`}
                width="960"
                height="540"
                loading="lazy"
                class:list={["mb-6 aspect-video w-full rounded-card border-[3px] border-ink object-cover object-top", w.features && "md:max-w-xl"]}
              />
            )}
            <p class="font-mono text-xs font-bold uppercase">{w.kind}</p>
            <p class="mt-2 font-display text-3xl font-black uppercase [font-stretch:125%]">{w.name}</p>
            <p class="mt-3 max-w-3xl text-lg">{w.summary}</p>
            {w.features && (
              <div class="mt-6 grid gap-x-10 gap-y-6 font-mono text-[15px] md:grid-cols-2">
                {w.features.map((f) => (
                  <div class="border-t-2 border-dashed border-hairline pt-4">
                    <p class="text-xs font-bold uppercase">{f.group}</p>
                    <ul class="mt-3 space-y-2">
                      {f.items.map((item) => (
                        <li class="flex gap-3">
                          <span aria-hidden="true" class="font-bold">1x</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
            {w.url && <a href={w.url} class="mt-6 inline-block font-bold underline decoration-accent decoration-[3px]">Visit the site</a>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
    <h2 class="text-[clamp(2rem,5vw,3.5rem)]">Fair questions</h2>
    <div class="mt-8"><Faq /></div>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <AskOwner topic="pixel" />
  </section>
</Base>
