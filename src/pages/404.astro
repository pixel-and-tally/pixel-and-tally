---
import Base from "../layouts/Base.astro";
import CtaLink from "../components/CtaLink.astro";
---

<Base title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm font-bold uppercase">Error 404</p>
    <h1 class="mt-3 text-[clamp(3rem,9vw,6rem)]">Not on the <span class="text-accent">menu.</span></h1>
    <p class="mt-6 text-xl">That page isn't here. The link may be old.</p>
    <div class="mt-10"><CtaLink href="/">Go to the home page</CtaLink></div>
  </section>
</Base>
