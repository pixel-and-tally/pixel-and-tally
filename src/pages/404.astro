---
import Base from "../layouts/Base.astro";
import CtaLink from "../components/CtaLink.astro";
---

<Base title="Page not found" noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <h1 class="text-4xl font-extrabold md:text-5xl">That page isn't here</h1>
    <p class="mt-4 text-lg text-muted">The link may be old. Everything else is one click away.</p>
    <div class="mt-8"><CtaLink href="/">Go to the home page</CtaLink></div>
  </section>
</Base>
