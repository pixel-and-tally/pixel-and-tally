---
import Base from "../layouts/Base.astro";
import Tabs from "../components/Tabs.astro";
import Receipt from "../components/Receipt.astro";
import AskOwner from "../components/AskOwner.astro";
import { tally, tallyPlans, automations } from "../site";

const questions = [
  "Which nights are worth staying open?",
  "Which items or services carry the business?",
  "Is labor eating the margin on slow days?",
  "When are you busiest, and are you staffed for it?",
];
const tilt = ["-rotate-2", "rotate-1", "rotate-2", "-rotate-1"];
---

<Base title="Tally: data and automation" description="Data checkups, owner dashboards, workflow automations and API connections for small businesses.">
  <div class="mx-auto max-w-6xl px-4 pt-10 sm:px-6"><Tabs /></div>

  <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <h1 class="max-w-5xl text-[clamp(2.75rem,7vw,6rem)]">
      Your numbers on one page. <span class="text-accent-2">Read it in five minutes.</span>
    </h1>
    <div class="mt-8 grid gap-6 text-lg leading-relaxed md:grid-cols-2">
      <p>
        Your POS, booking app and spreadsheets already know a lot about your business. They just don't talk to each
        other, and nobody has time to dig. I pull the exports, clean them up, and turn them into answers.
      </p>
      <p>
        This is my day job: SQL and Tableau dashboards that sales directors use to run teams in four countries. I also
        spent a summer at a Charlotte CPA firm, so a P&L or a QuickBooks export doesn't scare me.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <h2 class="text-[clamp(2rem,5vw,3.5rem)]">Questions it answers</h2>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        questions.map((q, i) => (
          <li class:list={["sticker flex aspect-square items-end bg-accent-2 p-5 text-2xl leading-tight font-bold", tilt[i]]}>{q}</li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-20 grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-2 md:items-start">
    <Receipt title="Tally / Numbers" ticket="No. 03" offers={tally} tone="tally" />
    <div class="flex min-w-0 flex-col gap-10">
      <p class="text-lg leading-relaxed">
        Not sure you need a dashboard? Start with the checkup. It's the fastest way to see what your data can tell you.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6">
    <h2 class="max-w-4xl text-[clamp(2rem,5vw,3.5rem)]">Make your tools <span class="text-accent-2">talk to each other.</span></h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed">
      If you're copying bookings into a spreadsheet, retyping orders into QuickBooks, or texting reminders by hand, that's
      a job a workflow can do. I connect the apps you already pay for so the data moves on its own, and when there's no
      ready-made connection, I write one against their API.
    </p>
  </section>

  <section class="mx-auto mt-12 grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-2 md:items-start">
    <Receipt title="Tally / Automation" ticket="No. 04" offers={automations} tone="tally" />
    <Receipt title="Tally / Monthly" ticket="No. 05" offers={tallyPlans} tone="tally" footer="Cancel any time, 30 days' notice" />
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <AskOwner topic="tally" />
  </section>
</Base>
