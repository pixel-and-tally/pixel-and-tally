---
import Base from "../layouts/Base.astro";
import CtaLink from "../components/CtaLink.astro";
---

<Base title="Thanks" noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <h1 class="text-4xl md:text-5xl">Got it. Thanks!</h1>
    <p class="mt-4 text-lg text-muted">
      Your note is with me. If you picked a time, I'll confirm it by email. Either way, you'll hear back within one
      business day.
    </p>
    <div class="mt-8"><CtaLink href="/" variant="ghost">Back to the home page</CtaLink></div>
  </section>
</Base>
