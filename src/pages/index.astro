---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import CtaLink from "../components/CtaLink.astro";
import Marquee from "../components/Marquee.astro";
import TicketRail from "../components/TicketRail.astro";
import { site, availability, steps, shoutouts } from "../site";

const tabs = [
  { ...site.tabs[0], tone: "bg-accent", tilt: "md:-rotate-2", line: "A website that takes bookings and orders while you're busy.", price: "From $1,800" },
  { ...site.tabs[1], tone: "bg-accent-2", tilt: "md:rotate-1", line: "Your sales, labor and bookings on one page you can read in five minutes.", price: "$300 checkup / $1,500 dashboard" },
  { ...site.tabs[2], tone: "bg-accent-3", tilt: "md:-rotate-1", line: "The site brings people in. The numbers tell you what they're worth.", price: "Combo $1,950" },
];
---

<Base>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 pt-10 sm:px-6 md:grid-cols-[1.35fr_1fr] md:items-center md:pt-16">
    <div>
      <h1 class="text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.88]">
        Get booked.<br /><span class="text-accent">Know your numbers.</span>
      </h1>
      <p class="mt-7 max-w-xl text-xl leading-relaxed">
        I'm {site.firstName}. I build websites for Charlotte restaurants and small businesses, and I make sense of their
        sales data. Most people who do one can't do the other. You deal with me, start to finish.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <CtaLink href="/contact/">Book a {availability.callMinutes}-min video call</CtaLink>
        <CtaLink href="#menu" variant="ghost">See the menu</CtaLink>
      </div>
    </div>
    <Portrait class="aspect-[4/5] w-full max-w-[260px] justify-self-center md:max-w-none" />
  </section>

  <Marquee items={shoutouts} />

  <section id="menu" class="mx-auto max-w-6xl scroll-mt-6 px-4 pt-20 sm:px-6">
    <h2 class="text-[clamp(2.5rem,6vw,4.5rem)]">Pick your order</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        tabs.map((t) => (
          <a href={t.href} class:list={["sticker group flex flex-col p-6 transition-transform hover:-translate-y-1", t.tone, t.tilt]}>
            <span class="font-mono text-xs font-bold uppercase">{t.blurb}</span>
            <span class="mt-4 font-display text-5xl leading-none font-black uppercase [font-stretch:125%]">{t.label}</span>
            <span class="mt-4 flex-1 text-lg leading-snug">{t.line}</span>
            <span class="mt-6 flex items-center justify-between border-t-[3px] border-ink pt-3 font-mono text-sm font-bold uppercase">
              {t.price}
              <span aria-hidden="true" class="text-2xl transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <h2 class="text-[clamp(2.5rem,6vw,4.5rem)]">How an order goes</h2>
    <div class="mt-12"><TicketRail steps={steps} /></div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <div class="sticker flex flex-col gap-6 bg-card p-8 md:flex-row md:items-center md:justify-between md:p-10">
      <div>
        <p class="font-mono text-sm font-bold uppercase">Reviews so far: 0</p>
        <p class="mt-3 max-w-2xl text-2xl leading-snug font-bold">
          I'm new to doing this on my own, and I'm not going to make reviews up. My first three clients get 15% off in
          exchange for an honest one.
        </p>
      </div>
      <CtaLink href="/both/" variant="secondary" class="shrink-0">Founding deal</CtaLink>
    </div>
  </section>
</Base>
