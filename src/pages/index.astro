---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import HeroTicket from "../components/HeroTicket.astro";
import CtaLink from "../components/CtaLink.astro";
import Marquee from "../components/Marquee.astro";
import TicketRail from "../components/TicketRail.astro";
import Faq from "../components/Faq.astro";
import { site, availability, steps, shoutouts, expertise, pixel, pixelPieces, work } from "../site";

// Booking websites are the front door. Tally and the builder are what comes after.
const later = [
  { ...site.tabs[1], tone: "bg-accent-2", line: "Your numbers on one page, and your tools wired together so the busywork does itself.", price: "From $300" },
  { ...site.tabs[2], tone: "bg-accent-3", line: "Mix anything from both menus into one package, with a combo discount.", price: "Build your own" },
];
const wants = [
  "Take bookings while I'm working",
  "Collect deposits so no-shows cost me less",
  "Show my menu and take orders",
  "Show up when people search near me",
  "Let me update prices and photos myself",
  "Sell products online",
  "Stop answering the same questions by phone",
  "Show me which services make the most money",
  "Send reminders without me texting",
  "Look as good as the business actually is",
];
const piece = (name: string) => pixelPieces.find((o) => o.name === name)?.price ?? "";
---

<Base fullTitle={`Booking websites for Charlotte small businesses | ${site.name}`}>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 pt-10 sm:px-6 md:grid-cols-[1.35fr_1fr] md:items-center md:pt-16">
    <div>
      <h1 class="text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.88]">
        Get booked<br /><span class="text-accent">while you work.</span>
      </h1>
      <p class="mt-7 max-w-xl text-xl leading-relaxed">
        I'm {site.firstName}, the owner. We build websites for Charlotte restaurants and small businesses that take
        bookings and orders on their own, so you stop losing customers to a ringing phone. You deal with me from the first
        call to launch.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <CtaLink href="/contact/">Book a {availability.callMinutes}-min video call</CtaLink>
        <CtaLink href="#menu" variant="ghost">See what it costs</CtaLink>
      </div>
      <p class="mt-6 font-mono text-sm font-bold uppercase">Prices on the page. Reply within one business day.</p>
    </div>
    <HeroTicket />
  </section>

  <Marquee items={shoutouts} />

  <section id="menu" class="mx-auto max-w-6xl scroll-mt-6 px-4 pt-20 sm:px-6">
    <h2 class="text-[clamp(2.5rem,6vw,4.5rem)]">Your website. <span class="text-accent">Endless opportunities.</span></h2>
    <ul class="mt-8 flex flex-wrap gap-3">
      {
        wants.map((w, i) => (
          <li class:list={["sticker flex items-center gap-3 bg-card px-4 py-3 text-lg font-bold", i % 3 === 0 ? "-rotate-1" : i % 3 === 1 ? "rotate-1" : ""]}>
            <span aria-hidden="true" class="grid h-6 w-6 shrink-0 place-items-center rounded-md border-[3px] border-ink text-sm">✕</span>
            {w}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 max-w-2xl text-lg">Pick what you need. If it's on this list, we've built it. If it isn't, ask anyway.</p>
    <div class="sticker mt-10 grid gap-8 bg-accent p-6 md:grid-cols-[1.2fr_1fr] md:p-10">
      <div>
        <p class="font-mono text-xs font-bold uppercase">Pixel / {site.tabs[0].blurb}</p>
        <p class="mt-4 max-w-xl text-xl leading-snug">
          Customers book, order and find your hours without calling. We build it, launch it, keep it running, and help
          with your logo if it needs it.
        </p>
        <p class="mt-6 max-w-xl text-lg leading-snug">
          Most web shops won't give you a price until after a meeting. Ours are right here, fixed, and written into your
          quote. <a href="#work" class="font-bold underline decoration-[3px]">See what we've built</a>.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <CtaLink href="/pixel/" variant="secondary">See the website menu</CtaLink>
        </div>
      </div>
      <ul class="flex flex-col gap-4">
        {
          pixel.map((o) => (
            <li class="rounded-card border-[3px] border-ink bg-card p-5">
              <p class="flex items-baseline justify-between gap-4 font-mono font-bold uppercase">
                <span>{o.name}</span>
                <span>{o.price}</span>
              </p>
              <p class="mt-2 leading-snug">{o.summary}</p>
            </li>
          ))
        }
        <li class="rounded-card border-[3px] border-dashed border-ink bg-card p-5">
          <p class="font-mono font-bold uppercase">Or pick custom features</p>
          <p class="mt-2 leading-snug">
            One page for {piece("Base Site")}, then {piece("Extra Page")} per extra page. Add booking, payments or forms
            only if you need them.
          </p>
        </li>
      </ul>
    </div>

    <h3 class="mt-16 font-display text-2xl font-black uppercase [font-stretch:125%]">Beyond the website</h3>
    <p class="mt-2 max-w-2xl text-lg">Already have a site you like? Start here instead. Or add these once your site is up:</p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        later.map((t) => (
          <a href={t.href} class:list={["sticker group flex flex-col p-5 transition-transform hover:-translate-y-1", t.tone]}>
            <span class="font-mono text-xs font-bold uppercase">{t.blurb}</span>
            <span class="mt-2 font-display text-3xl leading-none font-black uppercase [font-stretch:125%]">{t.label}</span>
            <span class="mt-3 flex-1 leading-snug">{t.line}</span>
            <span class="mt-4 flex items-center justify-between border-t-[3px] border-ink pt-3 font-mono text-sm font-bold uppercase">
              {t.price}
              <span aria-hidden="true" class="text-2xl transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section id="work" class="mx-auto max-w-6xl scroll-mt-6 px-4 pt-24 sm:px-6">
    <p class="font-mono text-sm font-bold uppercase">Real sites, all running</p>
    <h2 class="mt-3 text-[clamp(2.5rem,6vw,4.5rem)]">Imagining something for your business? <span class="text-accent">I can build it.</span></h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed">
      These aren't just pretty pages. Under each one, data moves on its own: payments from Stripe and PayPal, prices
      from Google Shopping, card details from PSA, texts through Twilio, scheduled jobs that email the owner every
      morning. Every one is a working site for a real business, so click around.
    </p>
    <ul class="mt-10 grid gap-8 md:grid-cols-3">
      {
        work.map((w, i) => (
          <li class:list={["sticker flex flex-col overflow-hidden bg-card", i === 1 ? "md:translate-y-6" : ""]}>
            {w.image && (
              <img
                src={w.image}
                alt={`The ${w.name} home page`}
                width="960"
                height="540"
                loading="lazy"
                class="aspect-video w-full border-b-[3px] border-ink object-cover object-top"
              />
            )}
            <div class="flex flex-1 flex-col p-5">
              <p class="font-mono text-xs font-bold uppercase">{w.kind}</p>
              <p class="mt-2 font-display text-2xl leading-none font-black uppercase [font-stretch:125%]">{w.name}</p>
              {w.highlights && (
                <ul class="mt-4 flex-1 space-y-2 font-mono text-sm">
                  {w.highlights.map((h) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="font-bold">1x</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}
              <a href={w.url} class="mt-5 font-bold underline decoration-accent decoration-[3px]">
                Visit {w.name}<span class="sr-only"> (opens the live site)</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-14 text-lg">
      Want the full list of what went into each one? <a href="/pixel/#work" class="font-bold underline decoration-[3px]">See the build notes</a>.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <h2 class="text-[clamp(2.5rem,6vw,4.5rem)]">How an order goes</h2>
    <div class="mt-12"><TicketRail steps={steps} /></div>
  </section>

  <section id="owner" class="mx-auto grid max-w-6xl gap-10 px-4 pt-24 sm:px-6 md:grid-cols-[1fr_1.3fr] md:items-center">
    <Portrait class="aspect-[4/5] w-full max-w-sm justify-self-center md:justify-self-start" />
    <div>
      <p class="font-mono text-sm font-bold uppercase">Free {availability.callMinutes}-minute consult</p>
      <h2 class="mt-3 text-[clamp(2.5rem,6vw,4.5rem)]">Talk to the <span class="text-accent">owner.</span></h2>
      <p class="mt-6 text-lg leading-relaxed">
        Your first call is with me, {site.owner}, face to face on video. I'll ask how your business runs, what's
        annoying you, and what you want more of. Then I take your order back to the kitchen, and we build the site
        around how you actually work. No templates, and I stay your contact the whole way.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <CtaLink href="/contact/">Book the free consult</CtaLink>
        <CtaLink href="/about/" variant="ghost">More about me</CtaLink>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <h2 class="text-[clamp(2.5rem,6vw,4.5rem)]">What I'm good at</h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed">
      Charlotte, NC native and NC State business and IT grad. Before Pixel & Tally I was a business operations analyst,
      building the dashboards sales directors used to run teams in four countries.
    </p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {
        expertise.map((e, i) => (
          <li class:list={["sticker bg-card p-5", i % 2 ? "lg:rotate-1" : "lg:-rotate-1"]}>
            <p class="font-display text-lg leading-none font-black uppercase [font-stretch:110%]">{e.area}</p>
            <p class="mt-3 text-sm leading-relaxed">{e.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="questions" class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <h2 class="text-[clamp(2.5rem,6vw,4.5rem)]">Fair <span class="text-accent">questions.</span></h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed">What owners ask before they hire anyone to build their site.</p>
    <div class="mt-10"><Faq /></div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <div class="sticker flex flex-col gap-6 bg-card p-8 md:flex-row md:items-center md:justify-between md:p-10">
      <div>
        <p class="font-mono text-sm font-bold uppercase">Reviews so far: 0</p>
        <p class="mt-3 max-w-2xl text-2xl leading-snug font-bold">
          I'm new to doing this on my own, and I'm not going to make reviews up. Until real ones show up here, judge me by
          the sites above.
        </p>
      </div>
      <CtaLink href="/contact/" variant="secondary" class="shrink-0">Book a call</CtaLink>
    </div>
  </section>
</Base>
