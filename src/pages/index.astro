---
import Base from "../layouts/Base.astro";
import CtaLink from "../components/CtaLink.astro";
import { site, offers, steps, work, foundingOffer } from "../site";

const web = offers.filter((o) => o.line === "web");
const data = offers.filter((o) => o.line === "data");
---

<Base>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 md:pt-24">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-2">{site.location} · Web design & data</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-extrabold leading-[1.05] md:text-7xl">
      Websites that get you booked. Numbers you can actually read.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">
      I build sites for Charlotte restaurants and service businesses, and dashboards that show where the money goes.
      You deal with one real person from start to finish: me.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <CtaLink href="/contact/#book">Book a free {site.callLength} call</CtaLink>
      <CtaLink href="/services/" variant="ghost">See prices</CtaLink>
    </div>
    <p class="mt-6 font-display text-lg font-semibold">{site.tagline}</p>
  </section>

  <section class="border-y border-line bg-sunk">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
      <article class="rounded-card border border-line bg-card p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent">Pixel · Web</p>
        <h2 class="mt-3 text-3xl font-bold">A site that books, not just a site</h2>
        <p class="mt-3 text-muted">
          Customers book, order or find your hours without calling. Built for phones first, set up on Google, and
          looked after every month so it never goes stale.
        </p>
        <ul class="mt-5 flex flex-col gap-1.5 text-sm">
          {web.map((o) => <li><span class="font-semibold">{o.name}</span> from {o.price}</li>)}
          <li><span class="font-semibold">Care plans</span> from $95/mo</li>
        </ul>
      </article>
      <article class="rounded-card border border-line bg-card p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-2">Tally · Data</p>
        <h2 class="mt-3 text-3xl font-bold">Know which nights and items make money</h2>
        <p class="mt-3 text-muted">
          I pull the exports from your POS, booking tool or spreadsheets and turn them into one page you can read in
          five minutes: sales, best and worst sellers, labor, busy hours.
        </p>
        <ul class="mt-5 flex flex-col gap-1.5 text-sm">
          {data.map((o) => <li><span class="font-semibold">{o.name}</span> {o.price}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl font-bold md:text-4xl">How it works</h2>
    <ol class="mt-8 grid gap-6 md:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="rounded-card border border-line bg-card p-6">
            <p class="font-display text-3xl font-bold text-accent">{i + 1}</p>
            <h3 class="mt-2 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <h2 class="text-3xl font-bold md:text-4xl">Recent work</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        work.map((w) => (
          <article class="rounded-card border border-line bg-card p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">{w.kind}</p>
            <h3 class="mt-2 text-xl font-bold">{w.name}</h3>
            <p class="mt-2 text-sm text-muted">{w.summary}</p>
            {w.url && (
              <a href={w.url} class="mt-4 inline-block text-sm font-semibold text-accent underline">
                See the site
              </a>
            )}
          </article>
        ))
      }
      <article class="rounded-card border border-dashed border-line p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent-2">Reviews</p>
        <h3 class="mt-2 text-xl font-bold">Reviews worth waiting for</h3>
        <p class="mt-2 text-sm text-muted">
          I'm a new business, so there are no client reviews here yet, and I won't make any up. {foundingOffer}
        </p>
      </article>
    </div>
  </section>

  <section class="bg-ink text-inverse">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl font-bold md:text-4xl">Text me, I answer.</h2>
        <p class="mt-2 max-w-xl text-inverse/75">
          No account managers, no long contracts, no $10k agency quotes. A fixed price agreed before I start.
        </p>
      </div>
      <CtaLink href="/contact/#book">Book a free call</CtaLink>
    </div>
  </section>
</Base>
