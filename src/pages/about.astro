---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import CtaLink from "../components/CtaLink.astro";
import { site } from "../site";
---

<Base title="About" description={`${site.owner} builds websites and dashboards for Charlotte restaurants and small businesses.`}>
  <section class="mx-auto max-w-3xl px-4 pt-14 sm:px-6">
    <Portrait class="h-28 w-28" />
    <h1 class="mt-6 text-4xl md:text-5xl">About me</h1>
    <div class="mt-6 flex flex-col gap-5 text-lg leading-relaxed">
      <p>
        I'm {site.owner}. I grew up in Charlotte and studied business and IT at NC State.
      </p>
      <p>
        By day I'm a business operations analyst. I build the SQL and Tableau dashboards that sales directors use to run
        teams across four countries, for Fortune 500 utility clients. Before that I did data work at UNC Health and spent
        a summer in tax accounting at a Charlotte CPA firm.
      </p>
      <p>
        Pixel & Tally is me bringing that same work to local owners. "Pixel" is the website side. "Tally" is the
        numbers. Most web freelancers can't build a dashboard, and most analysts don't build websites, so I figured
        someone should do both.
      </p>
      <p>
        It's just me. When you text, I'm the one who answers. I use good tools to work fast, AI included, but there's
        no account manager and no one you get handed off to.
      </p>
    </div>

    <h2 class="mt-12 text-2xl">Who I work with</h2>
    <p class="mt-3 text-lg leading-relaxed">
      Owner-run restaurants, salons, barbers, detailers, cleaners, trades and studios, usually with somewhere between 1 and
      20 people on staff. {site.serviceArea}
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <CtaLink href="/contact/" variant="secondary">Book a call</CtaLink>
      {site.linkedin && <CtaLink href={site.linkedin} variant="ghost">LinkedIn</CtaLink>}
    </div>
  </section>
</Base>
