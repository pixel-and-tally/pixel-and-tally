---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}
const { href, variant = "primary", class: className = "" } = Astro.props;
const styles = {
  primary: "bg-accent text-inverse hover:bg-accent-strong",
  secondary: "bg-ink text-inverse hover:bg-ink/85",
  ghost: "border border-line bg-card text-ink hover:border-ink",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-control px-5 py-3 text-base font-semibold transition-colors",
    styles[variant],
    className,
  ]}><slot /></a
>
