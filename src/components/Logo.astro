---
// The mark: a pixel square beside four tally strokes. Colors come from theme tokens.
interface Props {
  class?: string;
}
const { class: className = "h-8 w-8" } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="2" y="9" width="12" height="14" rx="2.5" class="fill-accent"></rect>
  <g class="stroke-accent-2" stroke-width="2.6" stroke-linecap="round">
    <line x1="18" y1="9" x2="18" y2="23"></line>
    <line x1="22" y1="9" x2="22" y2="23"></line>
    <line x1="26" y1="9" x2="26" y2="23"></line>
    <line x1="16.5" y1="20.5" x2="29.5" y2="11.5"></line>
  </g>
</svg>
