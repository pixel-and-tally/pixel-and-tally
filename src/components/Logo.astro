---
// The mark: a tally of five. Four strokes are Tally (mint), the slash is Pixel (tomato).
// Colors come from theme tokens.
interface Props {
  class?: string;
}
const { class: className = "h-8 w-8" } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g class="stroke-accent-2" stroke-width="3" stroke-linecap="square">
    <line x1="7" y1="7" x2="7" y2="25"></line>
    <line x1="13" y1="7" x2="13" y2="25"></line>
    <line x1="19" y1="7" x2="19" y2="25"></line>
    <line x1="25" y1="7" x2="25" y2="25"></line>
  </g>
  <line x1="3" y1="21" x2="29" y2="11" class="stroke-accent" stroke-width="3.4" stroke-linecap="square"></line>
</svg>
