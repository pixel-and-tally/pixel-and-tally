---
// Cal.com inline embed. Renders an honest placeholder until site.calLink is set.
import CtaLink from "./CtaLink.astro";
import { site, bookingUrl } from "../site";

const url = bookingUrl();
const calPath = url.replace("https://cal.com/", "");
---

{
  url ? (
    <div class="overflow-hidden rounded-card border border-line bg-card">
      <div id="cal-inline" data-cal-link={calPath} class="min-h-[640px] w-full" />
      <noscript>
        <p class="p-6">
          <a href={url} class="font-semibold text-accent underline">
            Open the booking page
          </a>
        </p>
      </noscript>
    </div>
  ) : (
    <div class="rounded-card border border-dashed border-line bg-card p-8 text-center">
      <p class="font-display text-2xl font-bold">Online booking opens soon</p>
      <p class="mx-auto mt-2 max-w-md text-muted">
        Until then, send me a note with the form and I'll reply within one business day with a few times
        for a {site.callLength} call.
      </p>
      <CtaLink href="#message" variant="ghost" class="mt-5">
        Use the form
      </CtaLink>
    </div>
  )
}

{
  url && (
    <script is:inline define:vars={{ calPath }}>
      // Official Cal.com embed snippet (unchanged), then one inline calendar.
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", { origin: "https://cal.com" });
      Cal("inline", { elementOrSelector: "#cal-inline", calLink: calPath, layout: "month_view" });
      Cal("ui", { layout: "month_view" });
    </script>
  )
}
