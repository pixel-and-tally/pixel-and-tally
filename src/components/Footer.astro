---
import Logo from "./Logo.astro";
import { site } from "../site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-sunk">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
    <div>
      <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold">
        <Logo class="h-7 w-7" />
        {site.name}
      </a>
      <p class="mt-3 text-sm text-muted">{site.tagline}</p>
    </div>
    <nav aria-label="Footer" class="flex flex-col gap-2 text-sm">
      {site.nav.map((item) => <a href={item.href} class="text-muted hover:text-ink">{item.label}</a>)}
      <a href="/privacy/" class="text-muted hover:text-ink">Privacy</a>
    </nav>
    <div class="flex flex-col gap-2 text-sm text-muted">
      <p>Based in {site.location}. Working with US businesses only.</p>
      {site.email && <a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a>}
      {site.phone && <a href={`sms:${site.phone}`} class="hover:text-ink">Text {site.phone}</a>}
      {site.linkedin && <a href={site.linkedin} class="hover:text-ink">LinkedIn</a>}
    </div>
  </div>
  <p class="border-t border-line px-4 py-4 text-center text-xs text-muted">
    © {year} {site.name}. Built by {site.owner}.
  </p>
</footer>
