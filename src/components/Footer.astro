---
import { site } from "../site";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-10 text-sm text-muted sm:px-6 md:flex-row md:justify-between">
    <div class="max-w-sm">
      <p class="font-display text-lg font-semibold text-ink">{site.name}</p>
      <p class="mt-1">{site.tagline}</p>
      <p class="mt-3">Run by {site.owner}, a Charlotte native. US businesses only.</p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
      {[...site.tabs, ...site.nav].map((item) => <a href={item.href} class="hover:text-ink">{item.label}</a>)}
      <a href="/privacy/" class="hover:text-ink">Privacy</a>
      {site.linkedin && <a href={site.linkedin} class="hover:text-ink">LinkedIn</a>}
      {site.email && <a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a>}
      {site.phone && <a href={`sms:${site.phone}`} class="hover:text-ink">Text {site.phone}</a>}
    </nav>
  </div>
  <p class="pb-8 text-center text-xs text-muted">© {year} {site.name}</p>
</footer>
