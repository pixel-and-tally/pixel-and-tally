---
import type { Offer } from "../site";

interface Props {
  offer: Offer;
}
const { offer } = Astro.props;
const isData = offer.line === "data";
---

<article class="flex h-full flex-col rounded-card border border-line bg-card p-6">
  <p
    class:list={[
      "w-fit rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide",
      isData ? "bg-accent-2-soft text-accent-2" : "bg-accent-soft text-accent-strong",
    ]}
  >
    {isData ? "Data" : "Web"}
  </p>
  <h3 class="mt-4 text-2xl font-bold">{offer.name}</h3>
  <p class="mt-1 text-muted">{offer.summary}</p>
  <p class="mt-5 font-display text-4xl font-bold">
    {offer.price}<span class="text-base font-medium text-muted">{offer.cadence === "monthly" ? "/mo" : ""}</span>
  </p>
  <ul class="mt-5 flex flex-1 flex-col gap-2 text-sm">
    {
      offer.includes.map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class={isData ? "text-accent-2" : "text-accent"}>✓</span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
  {
    offer.cadence === "one-time" && (
      <p class="mt-5 border-t border-line pt-4 text-sm text-muted">Turnaround: {offer.turnaround}</p>
    )
  }
</article>
