---
// "Fair questions": the things owners check before hiring anyone for a website. Plain <details>, no script.
import { faqs } from "../site";
---

<div class="grid items-start gap-5 md:grid-cols-2">
  {
    faqs.map((f) => (
      <details class="sticker group bg-card p-5 open:bg-sunk">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display text-lg leading-tight font-black uppercase [font-stretch:110%] [&::-webkit-details-marker]:hidden">
          <span>{f.q}</span>
          <span aria-hidden="true" class="font-mono text-2xl leading-none transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-4 text-lg leading-relaxed">{f.a}</p>
      </details>
    ))
  }
</div>
