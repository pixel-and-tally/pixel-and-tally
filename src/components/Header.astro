---
import Logo from "./Logo.astro";
import { site } from "../site";

const path = Astro.url.pathname;
const links = [...site.tabs, ...site.nav];
---

<header class="border-b-[3px] border-ink bg-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-xl font-black uppercase [font-stretch:125%]">
      <Logo class="h-8 w-8" />
      <span>{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 md:flex">
      {
        links.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? "page" : undefined}
            class="font-bold uppercase underline-offset-[6px] hover:underline aria-[current=page]:underline aria-[current=page]:decoration-[3px] aria-[current=page]:decoration-accent"
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact/" class="rounded-control border-[3px] border-ink bg-ink px-4 py-2 font-extrabold uppercase text-inverse shadow-hard-sm">
        Book a call
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-control border-[3px] border-ink bg-card px-4 py-1.5 font-extrabold uppercase [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <nav aria-label="Main" class="sticker absolute right-0 z-40 mt-3 flex w-60 flex-col bg-card p-2">
        {links.map((item) => <a href={item.href} class="rounded-xl px-3 py-2 font-bold uppercase hover:bg-sunk">{item.label}</a>)}
        <a href="/contact/" class="mt-1 rounded-control bg-ink px-3 py-2 text-center font-extrabold uppercase text-inverse">Book a call</a>
      </nav>
    </details>
  </div>
</header>
