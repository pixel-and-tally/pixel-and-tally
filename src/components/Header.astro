---
import Logo from "./Logo.astro";
import CtaLink from "./CtaLink.astro";
import { site } from "../site";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-display text-xl font-bold">
      <Logo />
      <span>{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 md:flex">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? "page" : undefined}
            class="text-sm font-medium text-muted hover:text-ink aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      <CtaLink href="/contact/#book" class="px-4 py-2 text-sm">Book a free call</CtaLink>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center rounded-control border border-line bg-card px-3 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        aria-label="Main"
        class="absolute right-0 mt-2 flex w-60 flex-col gap-1 rounded-card border border-line bg-card p-2 shadow-lg"
      >
        {
          site.nav.map((item) => (
            <a href={item.href} class="rounded-control px-3 py-2 font-medium hover:bg-sunk">
              {item.label}
            </a>
          ))
        }
        <CtaLink href="/contact/#book" class="mt-1">Book a free call</CtaLink>
      </nav>
    </details>
  </div>
</header>
